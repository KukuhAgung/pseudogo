procedure InsertionSort(inout arr : array [1..N] of integer, in N : integer)
Kamus:
    i, j, temp : integer
Algoritma:
    for i <- 2 to N do
        temp <- arr[i]
        j <- i - 1

        while (j >= 1) and (arr[j] > temp) do
            arr[j + 1] <- arr[j]
            j <- j - 1
        end while

        arr[j + 1] <- temp
    end for
end procedure

Program TestInsertionSort
Kamus:
    data : array [1..6] of integer
    i : integer
Algoritma:
    data[1] <- 9
    data[2] <- 5
    data[3] <- 1
    data[4] <- 4
    data[5] <- 3
    data[6] <- 7
    InsertionSort(data, 6)
    for i <- 1 to 6 do
        output("data[", i, "] = ", data[i])
    end for
