function CekGenap(angka : integer) -> boolean
Kamus:
    hasil : boolean
Algoritma:
    if (angka mod 2 = 0) then
        hasil <- true
    else
        hasil <- false
    endif
    return hasil
endfunction

Program TestMisc
Kamus:
    namaMahasiswa : string
    nilai : integer
    indeks : char
    constant PHI : real = 3.14
    hitungan : integer
Algoritma:
    namaMahasiswa <- "Budi"
    output("Nama mahasiswa: ", namaMahasiswa, "\n")

    nilai <- 85
    if (nilai >= 80) then
        output("Indeks A", "\n")
    else if (nilai >= 70) then
        output("Indeks B", "\n")
    else
        output("Indeks C", "\n")
    endif

    indeks <- 'A'
    output("Indeks huruf: ", indeks, "\n")

    output("Nilai PHI: ", PHI, "\n")

    output("6 genap? ", CekGenap(6), "\n")
    output("7 genap? ", CekGenap(7), "\n")

    hitungan <- 0
    repeat
        hitungan <- hitungan + 1
        output("Hitungan ke: ", hitungan, "\n")
    until (hitungan = 3)
