procedure Inner(in a : integer, out b : integer)
Kamus:
Algoritma:
    b <- a * 10
endprocedure

procedure Outer(in a : integer, out result : integer)
Kamus:
Algoritma:
    Inner(a, result)
endprocedure

Program TestNested
Kamus:
    hasil : integer
Algoritma:
    Outer(7, hasil)
    output("Hasil: ", hasil, "\n")
