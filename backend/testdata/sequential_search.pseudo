constant NMAX : integer = 5
type arr_int : array [1..NMAX] of integer

procedure SequentialSearch(in arr : arr_int, in N : integer, in X : integer, out idx : integer)
Kamus:
    i : integer
    ketemu : boolean
Algoritma:
    i <- 1
    ketemu <- false

    while (i <= N) and (not ketemu) do
        if (arr[i] = X) then
            ketemu <- true
        else
            i <- i + 1
        endif
    end while

    if (ketemu = true) then
        idx <- i
    else
        idx <- -1
    endif
endprocedure

Program TestSequentialSearch
Kamus:
    data : arr_int
    hasil : integer
Algoritma:
    data[1] <- 10
    data[2] <- 25
    data[3] <- 7
    data[4] <- 42
    data[5] <- 3
    SequentialSearch(data, 5, 42, hasil)
    output("Indeks ditemukan (1-based): ", hasil, "\n")
    SequentialSearch(data, 5, 999, hasil)
    output("Hasil pencarian tidak ada: ", hasil, "\n")
